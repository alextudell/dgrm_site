---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  lang?: string;
}

const {
  title = "Diagram — Self-Coaching & Focus System",
  description = "Diagram combines executive self-coaching with frictionless planning. From big dreams to focused daily action — all in one quiet, offline-first space.",
  image = "/assets/og-image.jpg",
  imageAlt = "Diagram app — Turn Ambition into Daily Momentum",
  noindex = false,
  lang = "en",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dgrm.app');
const ogImageURL = new URL(image, Astro.site || 'https://dgrm.app');

// hreflang alternate URL computation
const isRu = lang === 'ru';
const currentPath = Astro.url.pathname;
// Derive counterpart path: /ru/foo → /foo and /foo → /ru/foo
const enPath = isRu ? currentPath.replace(/^\/ru/, '') || '/' : currentPath;
const ruPath = isRu ? currentPath : `/ru${currentPath === '/' ? '' : currentPath}`;
const enURL = new URL(enPath, Astro.site || 'https://dgrm.app');
const ruURL = new URL(ruPath, Astro.site || 'https://dgrm.app');
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#090A0F" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang Alternate Links (EN ↔ RU) -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ru" href={ruURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Font Preloads (Self-Hosted — Zero External CDN) -->
    <link rel="preload" href="/fonts/inter-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Language Auto-Detection on Root -->
    {lang === 'en' && (
      <script is:inline>
        (function() {
          const userLang = localStorage.getItem('user_lang_selected');
          const isRoot = window.location.pathname === '/' || window.location.pathname === '';
          if (isRoot) {
            if (userLang === 'ru') {
              window.location.replace('/ru');
              return;
            }
            if (userLang === 'en') {
              return;
            }
            const browserLang = navigator.language || navigator.userLanguage || '';
            if (browserLang.toLowerCase().startsWith('ru')) {
              window.location.replace('/ru');
            }
          }
        })();
      </script>
    )}

    <!-- Primary SEO Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- OpenGraph / Facebook / Telegram -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diagram" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org SoftwareApplication JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Diagram",
        "operatingSystem": "iOS, Android",
        "applicationCategory": "ProductivityApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Self-coaching and goal achievement app based on the Goal → Plan → Action → Reflection loop.",
        "url": "https://dgrm.app",
        "author": {
          "@type": "Organization",
          "name": "Diagram Team",
          "url": "https://dgrm.app"
        }
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased overflow-x-hidden transition-colors duration-200">
    <slot />
  </body>
</html>
