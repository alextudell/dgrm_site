---
import type { Translations } from '../../i18n/translations';

interface Props {
  t: Translations;
  lang: 'en' | 'ru';
}

const { t } = Astro.props;
const tabs = t.stage.tabs;
const tabsNav = t.stage.tabsNav;
---

<section id="stage" class="relative pt-24 sm:pt-40 pb-12 sm:pb-20 px-3.5 sm:px-6 lg:px-8 overflow-hidden text-center">
  <!-- Multi-layered Ambient Atmosphere -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] sm:w-[1100px] h-[450px] sm:h-[650px] ambient-glow-sapphire pointer-events-none opacity-50 blur-3xl"></div>
  <div class="absolute top-1/3 left-1/4 w-[400px] h-[400px] ambient-glow-ai pointer-events-none opacity-25 blur-3xl"></div>
  <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] ambient-glow-amber pointer-events-none opacity-20 blur-3xl"></div>

  <div class="max-w-6xl mx-auto relative z-10 space-y-7 sm:space-y-14">
    
    <!-- Hero Header Block -->
    <div class="max-w-4xl mx-auto space-y-5 sm:space-y-8">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full diagram-glass border border-border-highlight shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-rocket opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-rocket"></span>
        </span>
        <span class="text-xs font-semibold tracking-wide text-text-primary">
          {t.hero.badge}
        </span>
      </div>

      <!-- Main Headline (Display Monolith) -->
      <h1 class="text-[32px] sm:text-6xl lg:text-7xl font-extrabold tracking-tight sm:tracking-tighter leading-[1.12] sm:leading-[1.08] text-balance text-text-primary">
        <span>{t.hero.titleLine1} </span>
        <span class="bg-[image:var(--headline-gradient)] bg-clip-text text-transparent">
          {t.hero.titleHighlight}
        </span>
      </h1>

      <!-- Editorial Subtitle -->
      {t.hero.subtitle && (
        <p class="text-sm sm:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed font-normal text-balance">
          {t.hero.subtitle}
        </p>
      )}

      <!-- Tactical Dual CTAs (Apple-style responsive hierarchy) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-3.5 pt-1 sm:pt-2" id="download">
        <a 
          href="mailto:support@dgrm.app?subject=Google%20Play%20Beta%20Access%20Request" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 rounded-full btn-velvet-primary text-white font-semibold text-sm sm:text-base ring-1 ring-white/20 shadow-lg shadow-indigo-500/20"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.372 2.372 0 0 1-.362-.485V2.3c0-.173.125-.34.362-.486zm11.24 11.241l2.128 2.129-11.455 6.613 9.327-8.742zm0-2.11L5.522 2.203l11.455 6.613-2.128 2.129zm1.055 1.055l3.87 2.235c1.077.622 1.077 1.638 0 2.26l-3.87 2.235-2.103-2.104 2.103-2.626z"/>
          </svg>
          <span>{t.hero.joinBeta}</span>
        </a>

        <a 
          href="mailto:support@dgrm.app?subject=iOS%20TestFlight%20Invite%20Request" 
          class="w-full sm:w-auto px-5 sm:px-7 py-3 sm:py-4 rounded-full btn-secondary-tactile gap-2 text-xs sm:text-base font-medium sm:font-semibold"
        >
          <svg class="w-3.5 sm:w-4 h-3.5 sm:h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.04-1.82.92-2.88-.9.04-2 .6-2.64 1.36-.57.65-1.06 1.73-.93 2.77 1.01.08 2.03-.49 2.65-1.25z"/>
          </svg>
          <span>{t.hero.iosWaitlist}</span>
        </a>
      </div>
    </div>

    <!-- The Stage Switcher & Live Device Viewport -->
    <div id="interactive-stage-container" class="pt-2">
      
      <!-- Live Stage Container -->
      <div class="diagram-glass-elevated rounded-squircle-2xl sm:rounded-squircle-3xl p-4 sm:p-10 lg:p-12 border border-border-highlight shadow-2xl relative overflow-hidden text-left bg-grid-subtle">
        <!-- Dynamic Stage Halos behind device -->
        <div id="stage-halo" class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[520px] h-[520px] ambient-glow-sapphire opacity-60 pointer-events-none transition-all duration-700 blur-3xl"></div>
        <div class="absolute -top-24 -left-24 w-72 h-72 ambient-glow-sapphire opacity-20 pointer-events-none blur-3xl"></div>

        <!-- Cupertino-Grade Top Story Controller Bar (Glanceable on All Screen Sizes) -->
        <div class="pb-5 sm:pb-8 mb-6 sm:mb-8 border-b border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 relative z-20">
          <div class="flex items-center gap-2 self-start sm:self-center">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-text-secondary">{t.stage.eyebrow}</span>
          </div>

          <!-- Story Progress Rails (5 Step Bars) -->
          <div class="flex items-center justify-center gap-1.5 sm:gap-2.5 w-full sm:w-auto max-w-lg">
            {Object.entries(tabs).map(([key, tab], idx) => (
              <button
                type="button"
                data-stage-index={idx}
                data-stage-key={key}
                class="stage-rail-btn group relative flex-1 sm:w-20 lg:w-24 sm:flex-initial h-8 sm:h-7 rounded-full flex flex-col justify-center px-1 focus:outline-none transition-all cursor-pointer"
                aria-label={tab.label}
              >
                <!-- Step Label (Mobile Compact) -->
                <span class="text-[10px] sm:text-[11px] font-semibold text-text-muted group-hover:text-primary transition-colors text-center pb-1 truncate hidden xs:block sm:hidden">
                  {tab.label}
                </span>
                <!-- Rail Track -->
                <div class="w-full h-1.5 rounded-full bg-surface-soft overflow-hidden relative transition-all group-hover:bg-border-highlight">
                  <!-- Animated Fill Bar -->
                  <div class="stage-rail-fill h-full bg-primary rounded-full origin-left scale-x-0 transition-transform"></div>
                </div>
              </button>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-16 items-center relative z-10">
          
          <!-- Narrative Column (Left 6 Cols) -->
          <div id="stage-narrative" class="lg:col-span-6 space-y-4 sm:space-y-6 lg:space-y-8 min-h-0 lg:min-h-[460px] flex flex-col justify-center items-start transition-all duration-300">
            <div id="stage-tag-wrapper" class="inline-flex items-center gap-2.5 px-4 sm:px-5 py-1.5 sm:py-2 rounded-full bg-primary/10 border border-primary/20 text-primary dark:text-indigo-400 text-xs sm:text-[13px] font-semibold tracking-wide shadow-sm whitespace-nowrap self-start w-fit">
              <span id="stage-badge-icon" class="w-4 h-4 shrink-0 flex items-center justify-center text-primary dark:text-indigo-400">
                <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                </svg>
              </span>
              <span id="stage-tag">{tabs.goals.tag}</span>
            </div>

            <div class="space-y-2 sm:space-y-4 lg:space-y-5 w-full">
              <h3 id="stage-title" class="text-2xl sm:text-4xl lg:text-[42px] font-extrabold tracking-tight text-text-primary leading-[1.14] text-balance">
                {tabs.goals.title}
              </h3>

              <p id="stage-desc" class="text-sm sm:text-lg text-text-secondary leading-relaxed font-normal max-w-xl">
                {tabs.goals.desc}
              </p>
            </div>

            <!-- Soft-Premium Frosted Insight Card (Desktop / Wide Screen Only) -->
            <div class="hidden lg:block w-full relative group p-5 sm:p-6 rounded-squircle-xl bg-[var(--insight-card-bg)] border border-[var(--insight-card-border)] backdrop-blur-md transition-all duration-300 hover:border-primary/30">
              <div class="flex items-start gap-3.5">
                <div class="p-2 rounded-xl bg-primary/10 dark:bg-primary/20 text-primary dark:text-indigo-400 shrink-0 mt-0.5">
                  <svg class="w-4.5 h-4.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 7 1 8 3 8z"/>
                    <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 7 1 8 3 8z"/>
                  </svg>
                </div>
                <div class="space-y-2">
                  <p id="stage-quote" class="text-sm sm:text-base font-medium text-[var(--insight-card-text)] leading-relaxed font-sans italic">
                    "{tabs.goals.quote}"
                  </p>
                  <p id="stage-quote-author" class="text-xs sm:text-[13px] font-semibold text-primary dark:text-indigo-400 tracking-wide">
                    — {tabs.goals.quoteAuthor}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Phone Mockup Column (Right 6 Cols - Fluid Responsive on Mobile) -->
          <div class="lg:col-span-6 flex justify-center items-center py-1 sm:py-2 w-full">
            <div class="w-full max-w-full sm:max-w-[340px] lg:max-w-[350px] relative">
              
              <!-- Responsive Titanium Bezel (Clean fluid container on mobile < sm, authentic smartphone bezel on sm+) -->
              <div class="sm:device-frame-titanium p-0 sm:p-2 rounded-2xl sm:rounded-[46px] hover:scale-[1.01]">
                
                <!-- Screen Bezel Interior -->
                <div class="bg-[#0B0D13] dark:bg-[#0B0D13] rounded-2xl sm:rounded-[42px] overflow-hidden border border-white/10 sm:shadow-2xl relative w-full">
                  
                  <!-- Screen Specular Gloss Overlay -->
                  <div class="hidden sm:block screen-specular-gloss rounded-2xl sm:rounded-[36px]"></div>

                  <!-- Dynamic Island Header (Visible on sm+ screens to avoid double-status bar on mobile) -->
                  <div class="hidden sm:flex pt-3.5 pb-2.5 px-5 justify-between items-center text-[10px] font-semibold text-slate-400 select-none relative z-30">
                    <span>9:41</span>
                    <div class="w-18 h-4 bg-black rounded-full mx-auto flex items-center justify-end px-2 border border-white/10 shadow-inner">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span>5G</span>
                      <div class="w-4 h-2.5 border border-slate-400 rounded-sm p-0.5 flex items-center">
                        <div class="h-full w-full bg-slate-300 rounded-[1px]"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Dynamic Mockup Screen Content Container (Single-Slot Grid Stack) -->
                  <div id="device-screen" class="relative z-10 grid grid-cols-1 grid-rows-1 p-3.5 sm:p-4.5 text-left min-h-[580px] sm:min-h-[660px] h-auto sm:h-[660px] overflow-hidden touch-pan-y select-none">
                    
                    <!-- Screen State 1: Goals & Manifesto -->
                    <div id="screen-state-goals" class="stage-screen-view col-start-1 row-start-1 w-full h-full flex flex-col justify-between space-y-3.5 sm:space-y-3 text-left transition-all duration-500 ease-spring will-change-[transform,opacity] opacity-100 scale-100 translate-y-0 z-10 pointer-events-auto">
                      <div class="space-y-3.5 sm:space-y-3">
                        <!-- In-App Sub-Tabs Navigation -->
                        <div class="pb-2 border-b border-white/10">
                          <div class="flex items-center gap-3.5 sm:gap-3 text-xs sm:text-[11px] font-semibold overflow-x-hidden select-none">
                            <span class="text-white relative pb-1 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-primary after:rounded-full">{tabsNav.overview}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.today}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.plan}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.habits}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.journal}</span>
                          </div>
                        </div>

                        <!-- 16:9 Cover Banner Image -->
                        <div class="relative w-full aspect-[16/9] rounded-xl sm:rounded-2xl overflow-hidden border border-white/10 shadow-md">
                          <img 
                            src="/images/goal-cover-mvp.jpg" 
                            alt="Diagram MVP Cover" 
                            class="w-full h-full object-cover"
                            loading="eager"
                          />
                          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D13]/60 via-transparent to-transparent"></div>
                        </div>

                        <!-- Goal Title Block -->
                        <div class="space-y-0.5 pt-0.5">
                          <h4 class="text-base sm:text-sm font-bold text-white tracking-tight leading-snug">{tabs.goals.screen.name}</h4>
                          <p class="text-xs sm:text-[9.5px] text-slate-400">{tabs.goals.screen.status}</p>
                        </div>

                        <!-- "My Why" (Personal Manifesto) -->
                        <div class="p-3 sm:p-3 rounded-2xl bg-[#141824]/90 border border-dashed border-primary/40 space-y-1 shadow-sm">
                          <div class="text-xs sm:text-[9px] font-bold text-indigo-400 uppercase tracking-wide flex items-center gap-1.5 sm:gap-1">
                            <svg class="w-3 h-3 sm:w-2.5 sm:h-2.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>
                            </svg>
                            <span>{tabs.goals.screen.manifestoTitle}</span>
                          </div>
                          <p class="text-xs sm:text-[10px] text-slate-200 italic leading-relaxed sm:leading-snug font-sans">
                            "{tabs.goals.screen.manifestoBody}"
                          </p>
                        </div>

                        <!-- Progress Card -->
                        <div class="p-3 rounded-2xl bg-[#141824] border border-white/10 space-y-2">
                          <div class="flex justify-between items-center text-xs sm:text-[11px]">
                            <span class="text-slate-300 font-semibold">{tabs.goals.screen.progressLabel}</span>
                            <span class="text-indigo-400 font-bold">{tabs.goals.screen.progressPercent}</span>
                          </div>
                          <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-primary to-indigo-400 rounded-full w-[60%]"></div>
                          </div>
                          <div class="text-[11px] sm:text-[9px] text-slate-400">
                            <span>{tabs.goals.screen.progressSteps}</span>
                          </div>
                        </div>

                        <!-- Values Section (Single Core Value) -->
                        <div class="space-y-1.5 pt-0.5">
                          <div class="text-xs sm:text-[8.5px] text-slate-400 uppercase tracking-wider font-bold">
                            {tabs.goals.screen.valueTitle}
                          </div>
                          <div class="flex items-center">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-300 text-xs sm:text-[10px] font-medium">
                              {tabs.goals.screen.valueTag}
                            </span>
                          </div>
                        </div>

                        <!-- Bottom Twin Cards (Deadline & Reward) -->
                        <div class="grid grid-cols-2 gap-2.5 pt-1">
                          <!-- Deadline -->
                          <div class="p-3 rounded-2xl bg-[#141824] border border-white/5 space-y-2">
                            <div class="w-7 h-7 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xs font-bold border border-purple-500/20 shadow-sm">
                              ∞
                            </div>
                            <div class="space-y-0.5">
                              <div class="text-[11px] sm:text-[9px] text-slate-400 font-medium">{tabs.goals.screen.deadlineTitle}</div>
                              <div class="text-xs sm:text-[11px] font-bold text-white leading-tight">{tabs.goals.screen.deadlineValue}</div>
                            </div>
                          </div>

                          <!-- Reward -->
                          <div class="p-3 rounded-2xl bg-[#141824] border border-white/5 space-y-2">
                            <div class="w-7 h-7 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center border border-purple-500/20 shadow-sm">
                              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                                <polyline points="20 12 20 22 4 22 4 12"/>
                                <rect x="2" y="7" width="20" height="5"/>
                                <line x1="12" y1="22" x2="12" y2="7"/>
                                <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                                <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                              </svg>
                            </div>
                            <div class="space-y-0.5">
                              <div class="text-[11px] sm:text-[9px] text-slate-400 font-medium">{tabs.goals.screen.rewardTitle}</div>
                              <div class="text-xs sm:text-[11px] font-bold text-white leading-tight">{tabs.goals.screen.rewardValue}</div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Subtle Bottom Home Indicator -->
                      <div class="pt-2 flex justify-center shrink-0 mt-auto">
                        <div class="w-28 h-1 bg-slate-700/60 rounded-full"></div>
                      </div>
                    </div>

                    <!-- Screen State 2: Roadmap (Sequential Rails - Real App UI) -->
                    <div id="screen-state-roadmap" class="stage-screen-view col-start-1 row-start-1 w-full h-full flex flex-col justify-between space-y-2 text-left relative transition-all duration-500 ease-spring will-change-[transform,opacity] opacity-0 scale-[0.985] translate-y-1.5 z-0 pointer-events-none invisible">
                      <div class="space-y-2">
                        <!-- In-App Sub-Tabs Navigation (Plan Active) -->
                        <div class="pb-2 border-b border-white/10">
                          <div class="flex items-center gap-3.5 sm:gap-3 text-xs sm:text-[11px] font-semibold overflow-x-hidden select-none">
                            <span class="text-slate-500 font-medium">{tabsNav.overview}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.today}</span>
                            <span class="text-white relative pb-1 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-primary after:rounded-full">{tabsNav.plan}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.habits}</span>
                            <span class="text-slate-500 font-medium">{tabsNav.journal}</span>
                          </div>
                        </div>

                        <!-- Vertical Rails Timeline Container -->
                        <div class="space-y-2.5 sm:space-y-2 pt-0.5 relative">
                          
                          <!-- Stage 8: Completed -->
                          <div class="p-3 pl-4 rounded-3xl bg-[#141824] shadow-sm relative z-10"
                               style="border: 1.5px solid rgba(212, 163, 71, 0.25); border-left: 3.5px solid rgba(212, 163, 71, 0.7);">
                            <div class="flex items-center justify-between">
                              <div class="flex items-center gap-3">
                                <!-- Concentric Badge -->
                                <div class="w-7 h-7 rounded-full border border-amber-400/40 flex items-center justify-center shrink-0">
                                  <div class="w-5 h-5 rounded-full bg-[#C59B3F] flex items-center justify-center text-xs sm:text-[10px] font-bold text-[#1A1406] shadow-sm">
                                    {tabs.roadmap.screen.stage8Badge}
                                  </div>
                                </div>
                                <div class="space-y-0.5">
                                  <h4 class="text-xs sm:text-[11px] font-bold text-slate-100 leading-tight">{tabs.roadmap.screen.stage8Title}</h4>
                                  <p class="text-[11px] sm:text-[8.5px] text-slate-400">{tabs.roadmap.screen.stage8Tasks}</p>
                                  <!-- Progress bar directly under subtitle -->
                                  <div class="w-28 h-1 bg-slate-800 rounded-full overflow-hidden mt-1">
                                    <div class="h-full bg-amber-400 rounded-full w-full"></div>
                                  </div>
                                </div>
                              </div>
                              <svg class="w-4 h-4 shrink-0 text-slate-400 stroke-current fill-none stroke-2 self-start mt-0.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"/>
                              </svg>
                            </div>
                          </div>

                          <!-- Connecting Rail Line between Stage 8 and Stage 9 -->
                          <div class="relative flex items-center justify-center -my-2 h-4 z-0">
                            <div class="absolute -top-2.5 -bottom-2.5 w-[1.5px] bg-[#D4A347]"></div>
                            <div class="w-1.5 h-1.5 rounded-full bg-[#D4A347] relative z-10 shadow-sm"></div>
                          </div>

                          <!-- Stage 9: Active Focus -->
                          <div class="p-3 pl-6 rounded-3xl bg-[#141824] border border-white/5 relative z-10 shadow-lg space-y-3">
                            <!-- Left bracket accent -->
                            <div class="absolute -left-px -top-px -bottom-px w-7 pointer-events-none overflow-hidden rounded-l-3xl z-20">
                              <div class="absolute left-0 top-0 bottom-0 w-14 rounded-l-3xl"
                                   style="border-left: 3.5px solid rgba(52, 211, 153, 0.6); border-top: 1.5px solid rgba(52, 211, 153, 0.3); border-bottom: 1.5px solid rgba(52, 211, 153, 0.3);">
                              </div>
                            </div>
                            <!-- Stage 9 Header -->
                            <div class="flex items-center justify-between gap-2">
                              <div class="flex items-center gap-3 min-w-0">
                                <div class="w-7 h-7 rounded-full border border-emerald-400/40 flex items-center justify-center shrink-0">
                                  <div class="w-5 h-5 rounded-full bg-[#0D7F58] flex items-center justify-center text-xs sm:text-[10px] font-bold text-black shadow-sm">
                                    {tabs.roadmap.screen.stage9Badge}
                                  </div>
                                </div>
                                <div class="min-w-0 space-y-0.5">
                                  <h4 class="text-xs sm:text-[11px] font-bold text-white leading-tight">{tabs.roadmap.screen.stage9Title}</h4>
                                  <p class="text-[11px] sm:text-[8.5px] text-slate-400 font-medium">{tabs.roadmap.screen.stage9Tasks}</p>
                                  <div class="w-32 h-1 bg-slate-800 rounded-full overflow-hidden mt-1">
