    const stageKeys = Object.keys(tabsData);
    let currentIndex = 0;
    let autoRotateTimer = null;
    let isPaused = false;
    const ROTATION_DURATION = 6000;

    const halos = {
      goals: 'ambient-glow-sapphire',
      roadmap: 'ambient-glow-sapphire',
      rocket: 'ambient-glow-amber',
      journal: 'ambient-glow-sapphire',
      pulse: 'ambient-glow-emerald',
    };

    const icons = {
      goals: '<svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
      roadmap: '<svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M6 9v6M9 6h6a3 3 0 0 1 3 3v3"/><circle cx="18" cy="15" r="3"/></svg>',
      rocket: '<svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4.5c1.45-1.47 4.5-2 4.5-2"/><path d="M12 9v5s3.03-.55 4.5-2c1.47-1.45 2-4.5 2-4.5"/></svg>',
      journal: '<svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M6 6h10M6 10h10"/></svg>',
      pulse: '<svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="M12 2v20M2 12h20"/></svg>',
    };

    function activateStage(index) {
      currentIndex = index;
      const stage = stageKeys[currentIndex];
      if (!stage || !tabsData[stage]) return;
      const data = tabsData[stage];

      // Update progress rails
      railButtons.forEach((btn, i) => {
        const fill = btn.querySelector('.stage-rail-fill');
        if (!fill) return;

        if (i < currentIndex) {
          fill.style.transitionDuration = '200ms';
          fill.style.transform = 'scaleX(1)';
          fill.classList.remove('bg-primary');
          fill.classList.add('bg-text-muted', 'opacity-60');
        } else if (i === currentIndex) {
          fill.classList.remove('bg-text-muted', 'opacity-60');
          fill.classList.add('bg-primary');
          fill.style.transitionDuration = '0ms';
          fill.style.transform = 'scaleX(0)';
          requestAnimationFrame(() => {
            fill.style.transitionDuration = `${ROTATION_DURATION}ms`;
            fill.style.transform = 'scaleX(1)';
          });
        } else {
          fill.style.transitionDuration = '200ms';
          fill.style.transform = 'scaleX(0)';
        }
      });

      // Micro-animate narrative text & badge with Apple spring timing
      if (stageNarrative) {
        stageNarrative.style.transition = 'opacity 220ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms cubic-bezier(0.16, 1, 0.3, 1)';
        stageNarrative.style.opacity = '0.2';
        stageNarrative.style.transform = 'translateY(4px)';
        setTimeout(() => {
          if (stageBadgeIcon && icons[stage]) stageBadgeIcon.innerHTML = icons[stage];
          if (stageTag) stageTag.textContent = data.tag;
          if (stageTitle) stageTitle.textContent = data.title;
          if (stageDesc) stageDesc.textContent = data.desc;
          if (stageQuote) stageQuote.textContent = `"${data.quote}"`;
          if (stageQuoteAuthor) stageQuoteAuthor.textContent = `— ${data.quoteAuthor}`;
          stageNarrative.style.opacity = '1';
          stageNarrative.style.transform = 'translateY(0)';
        }, 140);
      }

      // Update halo glow
      if (stageHalo) {
        stageHalo.className = `absolute top-1/2 right-1/4 -translate-y-1/2 w-[520px] h-[520px] ${halos[stage] || 'ambient-glow-sapphire'} opacity-60 pointer-events-none transition-all duration-700 blur-3xl`;
      }

      // Switch screen state with GPU-accelerated spring cross-dissolve
      screenViews.forEach((view, i) => {
        if (i === currentIndex) {
          view.classList.remove('opacity-0', 'scale-[0.985]', 'translate-y-1.5', 'pointer-events-none', 'z-0', 'invisible');
          view.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'z-10', 'pointer-events-auto');
        } else {
          view.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'z-10', 'pointer-events-auto');
          view.classList.add('opacity-0', 'scale-[0.985]', 'translate-y-1.5', 'pointer-events-none', 'z-0', 'invisible');
        }
      });
    }

    function startAutoRotation() {
      stopAutoRotation();
      autoRotateTimer = setInterval(() => {
        if (!isPaused) {
          const nextIndex = (currentIndex + 1) % stageKeys.length;
          activateStage(nextIndex);
        }
      }, ROTATION_DURATION);
    }

    function stopAutoRotation() {
      if (autoRotateTimer) {
        clearInterval(autoRotateTimer);
        autoRotateTimer = null;
      }
    }

    // Rail click events
    railButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        activateStage(index);
        startAutoRotation();
      });
    });

    // Touch Swipe Gestures (Apple Tactile Standard)
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    const swipeTarget = deviceScreen || stageContainer;
    if (swipeTarget) {
      swipeTarget.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      swipeTarget.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipe();
      }, { passive: true });
    }

    function handleSwipe() {
      const deltaX = touchEndX - touchStartX;
      const deltaY = touchEndY - touchStartY;
      // Trigger if horizontal movement dominates and exceeds threshold (40px)
      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 40) {
        if (deltaX < 0) {
          // Swiped Left -> Next stage
          const nextIndex = (currentIndex + 1) % stageKeys.length;
          activateStage(nextIndex);
          startAutoRotation();
        } else {
          // Swiped Right -> Previous stage
          const prevIndex = (currentIndex - 1 + stageKeys.length) % stageKeys.length;
          activateStage(prevIndex);
          startAutoRotation();
        }
      }
    }

    // Pause on hover
    if (stageContainer) {
      stageContainer.addEventListener('mouseenter', () => {
        isPaused = true;
        const activeFill = railButtons[currentIndex]?.querySelector('.stage-rail-fill');
        if (activeFill) {
          activeFill.style.transitionDuration = '0ms';
        }
      });

      stageContainer.addEventListener('mouseleave', () => {
        isPaused = false;
        const activeFill = railButtons[currentIndex]?.querySelector('.stage-rail-fill');
        if (activeFill) {
          activeFill.style.transitionDuration = `${ROTATION_DURATION}ms`;
          activeFill.style.transform = 'scaleX(1)';
        }
      });
    }

    // Initialize first state and start timer
    activateStage(0);
    startAutoRotation();
  });
</script>
