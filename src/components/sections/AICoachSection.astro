---
import type { Translations, SupportedLanguage } from '../../i18n/translations';

interface Props {
  t: Translations;
  lang: SupportedLanguage;
}

const { t } = Astro.props;
const coach = t.aiCoach;
---

<section id="ai" class="py-14 sm:py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <!-- Ambient glow backdrop -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[750px] h-[450px] ambient-glow-ai opacity-15 pointer-events-none blur-3xl"></div>

  <div class="max-w-6xl mx-auto relative z-10 space-y-8 sm:space-y-16">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full diagram-glass border border-border-highlight text-primary text-xs font-bold uppercase tracking-widest">
        <span>✦</span>
        <span>{coach.eyebrow}</span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-text-primary leading-tight">
        {coach.title}
      </h2>
      <p class="text-sm sm:text-lg text-text-secondary leading-relaxed">
        {coach.subtitle}
      </p>
    </div>

    <!-- Mobile Horizontal Snap Carousel / Desktop 2x2 Grid -->
    <div class="w-full">
      <div 
        id="ai-coach-carousel"
        class="flex md:grid md:grid-cols-2 gap-4 sm:gap-8 max-w-5xl w-full mx-auto overflow-x-auto md:overflow-x-visible snap-x snap-mandatory no-scrollbar -mx-4 px-4 sm:mx-auto sm:px-0 py-2 scroll-smooth"
        style="-webkit-overflow-scrolling: touch;"
      >
        {coach.items.map((item, index) => (
          <div 
            data-carousel-card={index}
            class="w-[85%] sm:w-[70%] md:w-auto shrink-0 snap-center rounded-squircle-2xl diagram-glass feature-card-premium p-6 sm:p-10 border border-border-highlight flex flex-col justify-between space-y-6 group relative overflow-hidden"
          >
            
            <div class="space-y-4">
              <!-- Icon Badge -->
              <div class="w-12 h-12 rounded-2xl bg-primary/10 dark:bg-primary/15 border border-primary/25 text-primary dark:text-indigo-400 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                {item.icon === 'mic' && (
                  <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="22"/>
                  </svg>
                )}
                {item.icon === 'journal' && (
                  <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                    <path d="M6 6h10"/>
                    <path d="M6 10h10"/>
                    <path d="M6 14h6"/>
                  </svg>
                )}
                {item.icon === 'roadmap' && (
                  <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h12l4 6-10 12L2 9z"/>
                    <path d="M11 3 8 9l4 12 4-12-3-6"/>
                    <path d="M2 9h20"/>
                  </svg>
                )}
                {item.icon === 'harmony' && (
                  <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                  </svg>
                )}
              </div>

              <!-- Tag & Title -->
              <div class="space-y-1.5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-primary dark:text-indigo-400 block">
                  {item.tag}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-text-primary tracking-tight leading-snug">
                  {item.title}
                </h3>
              </div>

              <!-- Clean Description -->
              <p class="text-sm sm:text-base text-text-secondary leading-relaxed pt-1">
                {item.desc}
              </p>
            </div>

          </div>
        ))}
      </div>

      <!-- Cupertino-style Mobile Pagination Dots -->
      <div id="ai-coach-dots" class="flex md:hidden justify-center items-center gap-2 pt-4 select-none" role="tablist" aria-label="AI Coach Carousel Navigation">
        {coach.items.map((_, idx) => (
          <button 
            type="button"
            class={`carousel-dot h-2 rounded-full transition-all duration-300 focus:outline-none ${idx === 0 ? 'w-6 bg-primary' : 'w-2 bg-text-muted/30 dark:bg-white/25 hover:bg-text-muted/50'}`}
            data-carousel-dot={idx}
            aria-label={`Go to card ${idx + 1}`}
          ></button>
        ))}
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function initAiCarouselDots() {
    const carousel = document.getElementById('ai-coach-carousel');
    const dots = document.querySelectorAll('#ai-coach-dots [data-carousel-dot]');
    const cards = carousel ? carousel.querySelectorAll('[data-carousel-card]') : [];
    if (!carousel || dots.length === 0 || cards.length === 0) return;

    function setActiveDot(activeIdx) {
      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.remove('w-2', 'bg-text-muted/30', 'dark:bg-white/25');
          dot.classList.add('w-6', 'bg-primary');
        } else {
          dot.classList.remove('w-6', 'bg-primary');
          dot.classList.add('w-2', 'bg-text-muted/30', 'dark:bg-white/25');
        }
      });
    }

    function updateDots() {
      const carouselCenter = carousel.scrollLeft + carousel.clientWidth / 2;
      let closestIdx = 0;
      let minDistance = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.abs(carouselCenter - cardCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIdx = idx;
        }
      });

      setActiveDot(closestIdx);
    }

    carousel.addEventListener('scroll', updateDots, { passive: true });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        const targetCard = cards[idx];
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });
  })();
</script>
