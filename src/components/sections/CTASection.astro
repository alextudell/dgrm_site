---
import type { Translations, SupportedLanguage } from '../../i18n/translations';

interface Props {
  t: Translations;
  lang: SupportedLanguage;
}

const { t } = Astro.props;
---

<section id="download" class="py-12 sm:py-20 px-3.5 sm:px-6 lg:px-8 border-t border-border-subtle relative overflow-hidden text-center">
  <div class="max-w-5xl mx-auto relative z-10">
    
    <!-- Hero CTA Velvet Card -->
    <div class="diagram-glass-elevated rounded-squircle-2xl p-6 sm:p-14 lg:p-16 border border-border-highlight shadow-2xl relative overflow-hidden space-y-6 sm:space-y-8">
      <!-- Multi-layered Ambient Glow inside card -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] ambient-glow-sapphire opacity-40 pointer-events-none blur-3xl"></div>
      <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] ambient-glow-ai opacity-25 pointer-events-none blur-3xl"></div>

      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full diagram-glass border border-border-highlight text-xs font-semibold text-primary relative z-10 shadow-sm">
        <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4.5c1.45-1.47 4.5-2 4.5-2"/><path d="M12 9v5s3.03-.55 4.5-2c1.47-1.45 2-4.5 2-4.5"/>
        </svg>
        <span>{t.cta.badge}</span>
      </div>

      <!-- Main Heading -->
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary leading-tight relative z-10">
        {t.cta.title} <br class="hidden sm:inline" />
        <span class="text-primary">
          {t.cta.highlight}
        </span>
      </h2>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed relative z-10 font-normal">
        {t.cta.subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2 relative z-10">
        <a 
          href="mailto:support@dgrm.app?subject=Google%20Play%20Beta%20Access%20Request" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full btn-velvet-primary text-white font-semibold text-sm sm:text-base ring-1 ring-white/20 shadow-lg shadow-indigo-500/20"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a2.372 2.372 0 0 1-.362-.485V2.3c0-.173.125-.34.362-.486zm11.24 11.241l2.128 2.129-11.455 6.613 9.327-8.742zm0-2.11L5.522 2.203l11.455 6.613-2.128 2.129zm1.055 1.055l3.87 2.235c1.077.622 1.077 1.638 0 2.26l-3.87 2.235-2.103-2.104 2.103-2.626z"/>
          </svg>
          <span>{t.cta.betaButton}</span>
        </a>

        <a 
          href="mailto:support@dgrm.app?subject=iOS%20TestFlight%20Waitlist" 
          class="w-full sm:w-auto px-7 py-4 rounded-full btn-secondary-tactile gap-2.5 text-sm sm:text-base"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 7.17c.61-.75 1.04-1.8 0.93-2.85-.9.04-2.02.6-2.66 1.35-.57.65-1.07 1.73-.93 2.76 1.01.08 2.05-.51 2.66-1.26z"/>
          </svg>
          <span>{t.cta.iosButton}</span>
        </a>
      </div>

    </div>

  </div>
</section>

