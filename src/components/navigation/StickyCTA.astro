---
import type { Translations, SupportedLanguage } from '../../i18n/translations';
import { EXTERNAL_LINKS } from '../../config/links';

interface Props {
  t: Translations;
  lang: SupportedLanguage;
}

const { t, lang } = Astro.props;
---

<!-- Sticky Floating Conversion Pill (Mobile & Tablet) -->
<aside 
  id="sticky-conversion-pill" 
  class="fixed bottom-[max(env(safe-area-inset-bottom),1rem)] inset-x-0 z-40 px-4 pointer-events-none transition-all duration-500 transform translate-y-24 opacity-0 flex justify-center"
  aria-label="Quick download access"
>
  <div class="pointer-events-auto diagram-glass-elevated border border-border-highlight rounded-full p-1.5 pl-3.5 pr-2 flex items-center justify-between gap-3 shadow-2xl max-w-sm w-full backdrop-blur-2xl ring-1 ring-white/10">
    <!-- Brand Mark & Micro Title -->
    <a href={`/${lang === 'ru' ? 'ru' : ''}`} class="flex items-center gap-2 min-w-0 group focus:outline-none">
      <img 
        src="/assets/branding/Svg/diagram-mark-lavender.svg" 
        alt="Diagram" 
        class="w-5 h-5 shrink-0 group-hover:scale-105 transition-transform"
        width="20"
        height="20"
      />
      <span class="font-bold text-xs tracking-tight text-text-primary truncate">
        Diagram
      </span>
    </a>

    <!-- Action Buttons -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a 
        href={EXTERNAL_LINKS.googleGroupBeta}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full btn-velvet-primary text-white font-semibold text-xs shadow-sm transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a2.372 2.372 0 0 1-.362-.485V2.3c0-.173.125-.34.362-.486zm11.24 11.241l2.128 2.129-11.455 6.613 9.327-8.742zm0-2.11L5.522 2.203l11.455 6.613-2.128 2.129zm1.055 1.055l3.87 2.235c1.077.622 1.077 1.638 0 2.26l-3.87 2.235-2.103-2.104 2.103-2.626z"/>
        </svg>
        <span>{lang === 'ru' ? 'Бета-тест' : t.hero.joinBeta.split(' ')[0]}</span>
      </a>

      <button 
        type="button"
        data-open-waitlist
        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full btn-secondary-tactile text-text-primary font-medium text-xs shadow-sm transition-transform active:scale-95 cursor-pointer"
        title={t.hero.iosWaitlist}
      >
        <svg class="w-3 h-3 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.04-1.82.92-2.88-.9.04-2 .6-2.64 1.36-.57.65-1.06 1.73-.93 2.77 1.01.08 2.03-.49 2.65-1.25z"/>
        </svg>
        <span>iOS</span>
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  (function initStickyPill() {
    const pill = document.getElementById('sticky-conversion-pill');
    const heroCtas = document.getElementById('hero-cta-container') || document.getElementById('download');
    const bottomCta = document.querySelector('section#download:last-of-type') || document.querySelector('footer');

    if (!pill || !heroCtas) return;

    let heroPassed = false;
    let bottomReached = false;

    function updatePillVisibility() {
      if (heroPassed && !bottomReached) {
        pill.classList.remove('translate-y-24', 'opacity-0');
        pill.classList.add('translate-y-0', 'opacity-100');
      } else {
        pill.classList.remove('translate-y-0', 'opacity-100');
        pill.classList.add('translate-y-24', 'opacity-0');
      }
    }

    // Observer for Hero CTA block
    const heroObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          heroPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          updatePillVisibility();
        });
      },
      { threshold: 0 }
    );

    heroObserver.observe(heroCtas);

    // Observer for Bottom CTA / Footer
    if (bottomCta) {
      const bottomObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            bottomReached = entry.isIntersecting;
            updatePillVisibility();
          });
        },
        { threshold: 0.1 }
      );
      bottomObserver.observe(bottomCta);
    }

    // Scroll listener fallback for fine-grained responsiveness
    window.addEventListener('scroll', () => {
      const heroRect = heroCtas.getBoundingClientRect();
      heroPassed = heroRect.bottom < 0;
      if (bottomCta) {
        const bottomRect = bottomCta.getBoundingClientRect();
        bottomReached = bottomRect.top < window.innerHeight - 80;
      }
      updatePillVisibility();
    }, { passive: true });
  })();
</script>
