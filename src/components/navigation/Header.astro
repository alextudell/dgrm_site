---
import type { Translations, SupportedLanguage } from '../../i18n/translations';

interface Props {
  t: Translations;
  lang: SupportedLanguage;
}

const { t, lang } = Astro.props;
const homeUrl = lang === 'ru' ? '/ru' : '/';
---

<header 
  id="site-header" 
  class="site-header fixed top-0 left-0 right-0 z-50 w-full"
  data-scrolled="false"
  data-menu-open="false"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 sm:h-14 flex items-center justify-between">
    <!-- Brand Logo -->
    <a 
      href={homeUrl} 
      class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-lg py-1 pr-3 shrink-0"
      aria-label="Diagram Home"
    >
      <img 
        src="/assets/branding/Svg/diagram-mark-lavender.svg" 
        alt="Diagram Mark" 
        class="w-6 h-6 sm:w-7 sm:h-7 transition-transform duration-300 group-hover:scale-105"
        width="28"
        height="28"
      />
      <span class="font-bold text-base sm:text-lg tracking-tight text-text-primary group-hover:text-primary transition-colors">
        Diagram
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-[13px] font-medium text-text-secondary tracking-normal">
      <a href={`${homeUrl}#stage`} class="hover:text-text-primary transition-colors">{t.nav.stage}</a>
      <a href={`${homeUrl}#ai`} class="hover:text-text-primary transition-colors">{t.nav.aiCoach}</a>
      <a href={`${homeUrl}#ecosystem`} class="hover:text-text-primary transition-colors">{t.nav.ecosystem}</a>
      <a href={`${homeUrl}#faq`} class="hover:text-text-primary transition-colors">{t.nav.faq}</a>
    </nav>

    <!-- Right Controls: Language + Theme + Mobile Drawer Trigger -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Minimalist Segmented Language Switcher -->
      <div class="flex items-center p-0.5 rounded-full bg-surface-soft/60 dark:bg-white/[0.06] border border-border-subtle text-xs font-semibold">
        <a 
          href="/" 
          class={`px-2.5 py-0.5 rounded-full transition-all duration-200 ${lang === 'en' ? 'bg-surface text-text-primary shadow-xs' : 'text-text-muted hover:text-text-primary'}`}
          title="English"
          aria-label="Switch to English"
        >
          EN
        </a>
        <a 
          href="/ru" 
          class={`px-2.5 py-0.5 rounded-full transition-all duration-200 ${lang === 'ru' ? 'bg-surface text-text-primary shadow-xs' : 'text-text-muted hover:text-text-primary'}`}
          title="Русский"
          aria-label="Переключить на русский"
        >
          RU
        </a>
      </div>

      <!-- Theme Toggle Button -->
      <button 
        type="button" 
        id="theme-toggle-btn"
        aria-label={t.nav.themeToggle}
        class="w-8 h-8 rounded-full flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-black/5 dark:hover:bg-white/5 border border-transparent hover:border-border-subtle transition-all active:scale-95"
      >
        <svg class="w-4 h-4 dark:hidden fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <svg class="w-4 h-4 hidden dark:inline fill-none stroke-current stroke-2 text-amber-300" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
      </button>

      <!-- Mobile Menu Trigger (Apple-style 2-line Morphing Icon) -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
        class="md:hidden w-8 h-8 rounded-full flex items-center justify-center text-text-primary hover:bg-black/5 dark:hover:bg-white/5 transition-all focus:outline-none"
      >
        <div class="w-4 h-3 flex flex-col justify-between items-center relative pointer-events-none">
          <span id="burger-line-1" class="w-full h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
          <span id="burger-line-2" class="w-full h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Glass Navigation Drawer (Edge-to-Edge Full Viewport Overlay) -->
  <div
    id="mobile-nav-drawer"
    class="md:hidden fixed inset-x-0 top-12 bottom-0 z-40 bg-[var(--header-glass-bg)] backdrop-blur-2xl border-t border-border-subtle px-6 py-8 flex flex-col justify-between transition-all duration-300 opacity-0 pointer-events-none -translate-y-2 overflow-y-auto"
  >
    <nav class="space-y-1">
      <a
        href={`${homeUrl}#stage`}
        class="mobile-nav-link flex items-center justify-between py-4 text-xl font-semibold tracking-tight text-text-primary hover:text-primary transition-colors border-b border-border-subtle/50 group"
      >
        <span>{t.nav.stage}</span>
        <svg class="w-4 h-4 text-text-muted group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
      <a
        href={`${homeUrl}#ai`}
        class="mobile-nav-link flex items-center justify-between py-4 text-xl font-semibold tracking-tight text-text-primary hover:text-primary transition-colors border-b border-border-subtle/50 group"
      >
        <span>{t.nav.aiCoach}</span>
        <svg class="w-4 h-4 text-text-muted group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
      <a
        href={`${homeUrl}#ecosystem`}
        class="mobile-nav-link flex items-center justify-between py-4 text-xl font-semibold tracking-tight text-text-primary hover:text-primary transition-colors border-b border-border-subtle/50 group"
      >
        <span>{t.nav.ecosystem}</span>
        <svg class="w-4 h-4 text-text-muted group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
      <a
        href={`${homeUrl}#faq`}
        class="mobile-nav-link flex items-center justify-between py-4 text-xl font-semibold tracking-tight text-text-primary hover:text-primary transition-colors border-b border-border-subtle/50 group"
      >
        <span>{t.nav.faq}</span>
        <svg class="w-4 h-4 text-text-muted group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </nav>

    <div class="pt-6 space-y-4">
      <a
        href="mailto:support@dgrm.app?subject=Google%20Play%20Beta%20Access%20Request"
        class="mobile-nav-link w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full btn-velvet-primary text-white font-semibold text-sm shadow-md"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a2.372 2.372 0 0 1-.362-.485V2.3c0-.173.125-.34.362-.486zm11.24 11.241l2.128 2.129-11.455 6.613 9.327-8.742zm0-2.11L5.522 2.203l11.455 6.613-2.128 2.129zm1.055 1.055l3.87 2.235c1.077.622 1.077 1.638 0 2.26l-3.87 2.235-2.103-2.104 2.103-2.626z"/>
        </svg>
        <span>{t.hero.joinBeta}</span>
      </a>
    </div>
  </div>
</header>

<!-- Header & Mobile Drawer Client Script -->
<script is:inline>
  (function initHeader() {
    const header = document.getElementById('site-header');
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const line1 = document.getElementById('burger-line-1');
    const line2 = document.getElementById('burger-line-2');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    // Dynamic Scroll Listener
    function updateScroll() {
      if (!header) return;
      const isScrolled = window.scrollY > 8;
      header.setAttribute('data-scrolled', isScrolled ? 'true' : 'false');
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();

    // Theme Toggle
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }

    // Mobile Menu Drawer
    if (!menuBtn || !drawer) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menuBtn.setAttribute('aria-expanded', 'true');
      header?.setAttribute('data-menu-open', 'true');
      drawer.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
      drawer.classList.add('opacity-100', 'translate-y-0');
      if (line1 && line2) {
        line1.style.transform = 'translateY(5px) rotate(45deg)';
        line2.style.transform = 'translateY(-5px) rotate(-45deg)';
      }
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      isOpen = false;
      menuBtn.setAttribute('aria-expanded', 'false');
      header?.setAttribute('data-menu-open', 'false');
      drawer.classList.remove('opacity-100', 'translate-y-0');
      drawer.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
      if (line1 && line2) {
        line1.style.transform = '';
        line2.style.transform = '';
      }
      document.body.classList.remove('overflow-hidden');
    }

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on link click
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (isOpen && !drawer.contains(e.target) && !menuBtn.contains(e.target)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });
  })();
</script>
